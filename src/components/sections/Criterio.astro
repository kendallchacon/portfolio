---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import CodeWindow from "../common/CodeWindow.astro";
import SectionHead from "../common/SectionHead.astro";
import photo from "../../assets/about/kendall-profile.jpg";
import { contact } from "../../data/contact";
import { criterio } from "../../data/criterio";
import { pick } from "../../data/types";
import { useTranslations, type Lang } from "../../i18n/ui";

/**
 * Criterio, "El hilo": cuatro principios como una revisión de código. Por principio, un panel con
 * la ventana (gutter con las líneas reales y bandas resaltadas) y el comentario del autor encima
 * de su borde inferior.
 * - Escenario (≥1024 px, JS y sin reduced-motion; solo CSS, así el alto se fija antes de pintar):
 *   guía de 264 px (filas "tipo · repo" + título, selección que se desliza, hilo con nodos y
 *   contador) | stage al alto de la ventana (menos el navbar y un margen). Recorrido de 4 × 70svh más el stage. Tramos de cada paso (t): bandas y rama
 *   0.04–0.24, comentario 0.14–0.32, reposo 0.32–0.80 sin movimiento, cruce 0.80–1.
 *   scripts/criterio.ts escribe `--t` (progreso local) en paneles y ramas, y `--fill` y `--sel` en la
 *   guía; este CSS deriva de ahí el cruce, las bandas, el comentario, la selección y la rama (nodo
 *   activo → icono del gutter).
 *   Solo opacity, transform y stroke-dashoffset.
 * - Base (móvil, reduced-motion o sin JS): paneles apilados, comentario debajo, sin línea ni rama;
 *   reveal existente (una vez). Los pasos de la guía son una fila con snap que enlaza a cada panel.
 * Paleta de la maqueta → tokens: fondo bg, superficie surface-1, borde surface-3, acento accent,
 * comentario surface-2. Todo el CSS vive aquí (solo la portada): el CSS compartido no cambia.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// El usuario de GitHub sale del canal de contacto (github.com/<usuario>).
const handle = contact.channels.find((c) => c.id === "github")!.href.split("/").pop()!;

/** "carpeta/archivo": los dos últimos segmentos de la ruta (con la barra final si es carpeta). */
function tail(path: string): string {
  const parts = path.replace(/\/$/, "").split("/");
  return parts.slice(-2).join("/") + (path.endsWith("/") ? "/" : "");
}
---

<section
  id="criterio"
  data-criterio
  aria-labelledby="criterio-title"
  class="pt-[88px] pb-6 min-[980px]:pt-[120px] min-[980px]:pb-10"
>
  <div class="wrap">
    <SectionHead
      path={t("home.criterio.path")}
      title={t("home.criterio.title")}
      lead={t("home.criterio.lead")}
      headingId="criterio-title"
    />
  </div>

  <div class="wrap cr-track" data-cr-track>
    <div class="cr-stage" data-cr-stage>
      <nav class="cr-guide" data-cr-guide aria-label={t("home.criterio.list")}>
        <i class="cr-line" aria-hidden="true"></i>
        <i class="cr-fill" aria-hidden="true"></i>
        <i class="cr-sel" aria-hidden="true"></i>
        {
          criterio.map(({ id, kind, title, file }, i) => (
            <a href={`#criterio-${id}`} class="cr-step" data-cr-step style={`--k: ${i}`}>
              <span class="cr-meta">{`${pick(kind, lang)} · ${file.snippet.repo.name}`}</span>
              <span class="cr-label">
                <span class="cr-num">{String(i + 1).padStart(2, "0")}</span>
                {" "}
                <span class="cr-name">{pick(title, lang)}</span>
              </span>
              <i class="cr-node" data-cr-node aria-hidden="true" />
            </a>
          ))
        }
        <p class="cr-count" aria-hidden="true">
          <span data-cr-count>01</span>
          {" / "}
          {String(criterio.length).padStart(2, "0")}
        </p>
      </nav>

      <div class="cr-panels">
        {
          criterio.map(({ id, title, body, file }) => {
            const { snippet } = file;
            const name = snippet.path.replace(/\/$/, "").split("/").pop()!;
            const fileName = snippet.path.endsWith("/") ? `${name}/` : name;
            const fileUrl = "fileUrl" in file ? file.fileUrl : undefined;
            return (
              <article
                id={`criterio-${id}`}
                class="cr-panel"
                data-cr-panel
                data-rv-stagger
                aria-labelledby={`criterio-${id}-title`}
              >
                <div class="cr-main">
                  <CodeWindow
                    snippet={snippet}
                    class="flex flex-col overflow-hidden rounded-xl border border-line-strong bg-term cr-win"
                    codeClass={`m-0 flex-1 font-mono text-[12.5px]/[1.7] text-term-text cr-code${snippet.kind === "md" ? " cr-wrap" : ""}`}
                    label={t("home.criterio.code").replace("{file}", fileName)}
                    startLine={file.startLine}
                    highlight={file.highlight}
                  >
                    <span class="cr-path">
                      {snippet.repo.name} › {tail(snippet.path)}
                    </span>
                    {fileUrl ? (
                      <a class="cr-vis" href={fileUrl} rel="noopener">
                        <Icon name="lucide:arrow-up-right" aria-hidden="true" />
                        <span class="cr-vis-t">{t("home.criterio.public")}</span>
                      </a>
                    ) : (
                      <span class="cr-vis">
                        <Icon name="lucide:lock" aria-hidden="true" />
                        <span class="cr-vis-t">{t("home.criterio.private")}</span>
                      </span>
                    )}
                  </CodeWindow>
                </div>
                <div class="cr-comment">
                  <p class="cr-head">
                    <Image src={photo} alt="" width={48} height={48} fit="cover" class="cr-avatar" />
                    <strong class="cr-handle">{handle}</strong>
                    {" "}
                    <span class="cr-badge">{t("home.criterio.author")}</span>
                  </p>
                  <h3 id={`criterio-${id}-title`} class="cr-title">
                    {pick(title, lang)}
                  </h3>
                  <p class="cr-body">{pick(body, lang)}</p>
                </div>
              </article>
            );
          })
        }
      </div>

      <svg class="cr-branches" aria-hidden="true">
        {criterio.map(() => <path class="cr-branch" data-cr-branch pathLength="1" />)}
      </svg>
    </div>
  </div>
</section>

<style is:global>
  /* ── Base (móvil, reduced-motion, sin JS): paneles apilados, sin línea ni rama ───────────── */
  [data-criterio] .cr-guide {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  [data-criterio] .cr-line,
  [data-criterio] .cr-fill,
  [data-criterio] .cr-sel,
  [data-criterio] .cr-meta,
  [data-criterio] .cr-node,
  [data-criterio] .cr-count,
  [data-criterio] .cr-branches {
    display: none;
  }

  [data-criterio] .cr-step {
    display: flex;
    flex: 0 0 auto;
    max-width: 80%;
    padding: 10px 14px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-surface-1);
    color: var(--color-ink-2);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    scroll-snap-align: start;
  }

  [data-criterio] .cr-step:hover {
    color: var(--color-ink);
  }

  [data-criterio] .cr-num {
    margin-right: 6px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-ink-3);
  }

  [data-criterio] .cr-panels {
    display: grid;
    gap: 28px;
  }

  [data-criterio] .cr-panel {
    position: relative;
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  [data-criterio] .cr-main {
    min-width: 0;
  }

  /* Ventana: radio 20 px; la barra lleva la ruta y la visibilidad del repo. */
  [data-criterio] .cr-win {
    border-radius: 20px;
  }

  [data-criterio] .cr-path {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  [data-criterio] .cr-vis {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    color: var(--color-ink-2);
    text-decoration: none;
  }

  [data-criterio] a.cr-vis:hover {
    color: var(--color-ink);
  }

  [data-criterio] .cr-vis svg {
    width: 14px;
    height: 14px;
  }

  [data-criterio] .cr-code {
    padding: 18px 0;
    overflow-x: auto;
  }

  [data-criterio] .cr-code code {
    display: block;
    width: max-content;
    min-width: 100%;
  }

  [data-criterio] .cr-wrap code {
    width: auto;
  }

  /* Línea: gutter (icono + número real) y código. El gutter queda fijo al desplazar. */
  [data-criterio] .cw-l {
    position: relative;
    display: grid;
    grid-template-columns: 6ch 1fr;
    isolation: isolate;
  }

  [data-criterio] .cw-n {
    position: sticky;
    left: 0;
    z-index: 1;
    padding-right: 1.5ch;
    color: var(--color-ink-3);
    text-align: right;
    background: var(--color-term);
    user-select: none;
  }

  [data-criterio] .cw-c {
    padding: 0 18px 0 1ch;
    white-space: pre;
  }

  [data-criterio] .cr-wrap .cw-c {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Banda resaltada: redondeada y con margen, detrás del código. */
  [data-criterio] .cw-hl::before {
    content: "";
    position: absolute;
    inset: 0 10px 0 5.5ch;
    z-index: -1;
    border-radius: 6px;
    background: var(--color-accent-soft);
    transform-origin: left;
  }

  [data-criterio] .cw-hl .cw-n {
    color: var(--color-accent);
  }

  [data-criterio] .cw-ico {
    position: absolute;
    top: 0.28em;
    left: 0.4ch;
    color: var(--color-accent);
  }

  /* Comentario: radio 16, borde de acento al 35 %, sin sombra. */
  [data-criterio] .cr-comment {
    position: relative;
    z-index: 1;
    padding: 16px 18px 18px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: 16px;
    background: var(--color-surface-2);
  }

  [data-criterio] .cr-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    font-size: 14px;
    line-height: 1.4;
  }

  [data-criterio] .cr-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }

  [data-criterio] .cr-handle {
    font-weight: 600;
    color: var(--color-ink);
  }

  [data-criterio] .cr-badge {
    padding: 1px 8px;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: 12px;
    color: var(--color-ink-2);
  }

  [data-criterio] .cr-title {
    margin-top: 12px;
    font-size: 16px;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  [data-criterio] .cr-body {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  /* Móvil: la etiqueta de visibilidad queda solo para lectores; se ve el icono. */
  @media (max-width: 560px) {
    [data-criterio] .cr-vis-t {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* ── Escenario (≥1024 px, JS, sin reduced-motion) ──────────────────────────────────────── */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    /* --stick: top del sticky (navbar + margen, 84 px); el stage ocupa el resto menos 24 px.
       --overlap: lo que el comentario se monta sobre el borde inferior de la ventana. */
    html.js [data-criterio] {
      --stick: calc(var(--header-h) + 16px);
      --stage-h: calc(100svh - var(--stick) - 24px);
      --step: 70svh;
      --overlap: 24px;
    }

    /* Recorrido: 4 pasos de scroll más el propio stage, que se libera al final. */
    html.js [data-criterio] .cr-track {
      height: calc(4 * var(--step) + var(--stage-h));
    }

    html.js [data-criterio] .cr-stage {
      position: sticky;
      top: var(--stick);
      display: grid;
      grid-template-columns: 264px minmax(0, 1fr);
      gap: 44px;
      align-items: center;
      height: var(--stage-h);
    }

    /* Guía: tan alta como el stage. Filas de 232 × 88 px con el centro al 14, 38, 62 y 86 % del
       alto; a su derecha, el hilo y los nodos (centro x = 247.5 px). */
    html.js [data-criterio] .cr-guide {
      position: relative;
      display: block;
      align-self: start;
      height: var(--stage-h);
      margin: 0;
      overflow: visible;
    }

    /* Hilo base: 3 px, se desvanece en el 16 % de cada extremo. */
    html.js [data-criterio] .cr-line {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 246px;
      display: block;
      width: 3px;
      background: linear-gradient(
        transparent,
        var(--color-surface-3) 16%,
        var(--color-surface-3) 84%,
        transparent
      );
    }

    /* Progreso: 3 px de acento sobre un halo de 9 px (accent-soft, 14 %), del primer nodo al
       último; continuo entre nodos (`--fill` = 0–1). */
    html.js [data-criterio] .cr-fill {
      position: absolute;
      top: 14%;
      bottom: 14%;
      left: 243px;
      display: block;
      width: 9px;
      border-radius: 2px;
      background: linear-gradient(
        to right,
        var(--color-accent-soft) 3px,
        var(--color-accent) 3px 6px,
        var(--color-accent-soft) 6px
      );
      transform: scaleY(var(--fill, 0));
      transform-origin: top;
    }

    /* Selección: una tarjeta del tamaño de una fila que se desliza detrás de las filas. La capa
       ocupa la guía, así que translateY(24 %) es un paso; `--sel` = índice + u del cruce. */
    html.js [data-criterio] .cr-sel {
      position: absolute;
      inset: 0;
      display: block;
      pointer-events: none;
      transform: translateY(calc(24% * var(--sel, 0)));
      will-change: transform;
    }

    html.js [data-criterio] .cr-sel::before {
      content: "";
      position: absolute;
      top: calc(14% - 44px);
      left: 0;
      width: 232px;
      height: 88px;
      border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
      border-radius: 16px;
      background: var(--color-surface-1);
    }

    /* Fila: "tipo · repo" en mono y, debajo, número y título. Inactiva en ink-2 (8.6:1 sobre bg). */
    html.js [data-criterio] .cr-step {
      position: absolute;
      top: calc(14% + 24% * var(--k) - 44px);
      left: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 232px;
      max-width: none;
      height: 88px;
      padding: 0 12px 0 16px;
      border: 0;
      border-radius: 16px;
      background: none;
      color: var(--color-ink-2);
      font-size: 15px;
      line-height: 1.3;
    }

    html.js [data-criterio] .cr-meta {
      display: block;
      overflow: hidden;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 500;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    html.js [data-criterio] .cr-label {
      transition: color 0.2s;
    }

    html.js [data-criterio] .cr-num {
      color: var(--color-ink-2);
    }

    html.js [data-criterio] .cr-step:hover .cr-label,
    html.js [data-criterio] .cr-step[aria-current="step"] .cr-label {
      color: var(--color-ink);
    }

    html.js [data-criterio] .cr-step[aria-current="step"] .cr-num {
      color: var(--color-accent);
    }

    /* Nodos sobre el hilo: 5 px (escala 0.625 de 8 px); huecos si faltan, rellenos si se
       recorrieron; el activo, de 8 px con un anillo estático de r = 15 al 30 %. */
    html.js [data-criterio] .cr-node {
      position: absolute;
      top: calc(50% - 4px);
      left: 243.5px;
      z-index: 1;
      display: block;
      width: 8px;
      height: 8px;
      border: 1.6px solid var(--color-ink-3);
      border-radius: 50%;
      background: var(--color-bg);
      transform: scale(0.625);
      transition:
        transform 0.2s,
        background-color 0.2s,
        border-color 0.2s;
    }

    html.js [data-criterio] .cr-node::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 30px;
      height: 30px;
      margin: -15px 0 0 -15px;
      border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
      border-radius: 50%;
      opacity: 0;
    }

    html.js [data-criterio] .cr-step[data-done] .cr-node,
    html.js [data-criterio] .cr-step[aria-current="step"] .cr-node {
      border-color: var(--color-accent);
      background: var(--color-accent);
    }

    html.js [data-criterio] .cr-step[aria-current="step"] .cr-node {
      transform: none;
    }

    html.js [data-criterio] .cr-step[aria-current="step"] .cr-node::after {
      opacity: 1;
    }

    /* Contador al pie de la guía: el número actual en ink. */
    html.js [data-criterio] .cr-count {
      position: absolute;
      bottom: 0;
      left: 16px;
      display: block;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--color-ink-2);
    }

    html.js [data-criterio] [data-cr-count] {
      color: var(--color-ink);
    }

    html.js [data-criterio] .cr-panels {
      gap: 0;
    }

    /* Cruce atado 1:1 al scroll: u = smoothstep((t − 0.80) / 0.20). El saliente sube 34 px y se
       apaga; el entrante sube desde +34 px y aparece. El primero no entra y el último no sale. */
    html.js [data-criterio] :is(.cr-panel, .cr-branch) {
      --t: 0;
      --can-in: 1;
      --can-out: 1;
      --lo: clamp(0, calc((var(--t) - 0.8) / 0.2), 1);
      --li: clamp(0, calc((var(--t) + 0.2) / 0.2), 1);
      --uo: calc(var(--lo) * var(--lo) * (3 - 2 * var(--lo)) * var(--can-out));
      --ui: calc(1 - (1 - var(--li) * var(--li) * (3 - 2 * var(--li))) * var(--can-in));
      opacity: calc(var(--ui) * (1 - var(--uo)));
    }

    html.js [data-criterio] :is(.cr-panel, .cr-branch):first-child {
      --can-in: 0;
    }

    html.js [data-criterio] :is(.cr-panel, .cr-branch):last-child {
      --can-out: 0;
    }

    html.js [data-criterio] .cr-panel {
      grid-area: 1 / 1;
      align-self: center;
      gap: 0;
      transform: translateY(calc(34px * (1 - var(--ui)) - 34px * var(--uo)));
      will-change: transform, opacity;
    }

    /* El reveal no actúa aquí: el scroll manda. */
    html.js [data-criterio] .cr-panels .cr-panel > * {
      opacity: 1;
      transform: none;
      transition: none;
    }

    /* Código: escala con el alto de la ventana (line-height 1.7 de la clase). Margen inferior =
       solape + 20 px: la última línea, aunque haga wrap, queda siempre sobre el comentario. */
    html.js [data-criterio] .cr-code {
      padding-bottom: calc(var(--overlap) + 20px);
      font-size: clamp(12px, 1.6svh, 15px);
    }

    /* Bandas e icono: t 0.04 → 0.24. */
    html.js [data-criterio] .cw-hl::before {
      transform: scaleX(clamp(0, calc((var(--t) - 0.04) / 0.2), 1));
    }

    html.js [data-criterio] .cw-ico {
      opacity: clamp(0, calc((var(--t) - 0.04) / 0.2), 1);
      transform: scale(calc(0.6 + 0.4 * clamp(0, calc((var(--t) - 0.04) / 0.2), 1)));
    }

    /* Comentario: superpuesto --overlap al borde inferior; fundido y subida de 14 px,
       t 0.14 → 0.32. */
    html.js [data-criterio] .cr-panels .cr-panel > .cr-comment {
      margin: calc(-1 * var(--overlap)) 12px 0 40px;
      opacity: clamp(0, calc((var(--t) - 0.14) / 0.18), 1);
      transform: translateY(calc((1 - clamp(0, calc((var(--t) - 0.14) / 0.18), 1)) * 14px));
    }

    html.js [data-criterio] .cr-title {
      font-size: 17px;
    }

    html.js [data-criterio] .cr-body {
      font-size: 15px;
    }

    /* Rama: del nodo activo al icono del gutter; se dibuja t 0.04 → 0.24 (pathLength = 1). */
    html.js [data-criterio] .cr-branches {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }

    html.js [data-criterio] .cr-branch {
      fill: none;
      stroke: var(--color-accent);
      /* 65 %; en 0 antes de empezar, para que el extremo redondeado no deje un punto. */
      stroke-opacity: calc(0.65 * clamp(0, calc((var(--t) - 0.04) * 100), 1));
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-dasharray: 1;
      stroke-dashoffset: calc(1 - clamp(0, calc((var(--t) - 0.04) / 0.2), 1));
    }
  }
</style>

<script>
  import "../../scripts/reveal";
  import "../../scripts/criterio";
</script>
