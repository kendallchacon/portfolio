---
import type { Project } from "../../data/projects";
import Tag from "../common/Tag.astro";

interface Props {
  project: Project;
  featured?: boolean;
  delay?: number;
}

const { project, featured = false, delay } = Astro.props;

const badgeMap = {
  completado: {
    label: "Completado",
    class: "bg-cyan-500/10 text-cyan-400 border border-cyan-500/30",
  },
  "en-desarrollo": {
    label: "En desarrollo",
    class: "bg-yellow-500/10 text-yellow-400 border border-yellow-500/30",
  },
  proximo: {
    label: "Próximamente",
    class: "bg-slate-500/10 text-slate-400 border border-slate-500/30",
  },
};

const badge = badgeMap[project.estado];
const isPending = project.estado !== "completado";
---

<article
  class:list={[
    "reveal group relative flex flex-col overflow-hidden rounded-2xl border bg-slate-900/40 transition duration-300",
    featured
      ? "spotlight-card border-slate-700 hover:border-cyan-400/40"
      : "border-slate-800 opacity-60 hover:opacity-80 hover:border-slate-700",
  ]}
  style={delay !== undefined ? `transition-delay: ${delay}s;` : undefined}
>
  {featured && project.image && (
    <div class="relative overflow-hidden border-b border-slate-800">
      <img
        src={project.image}
        alt={project.imageAlt ?? project.nombre}
        class="h-56 w-full object-cover object-top transition duration-500 group-hover:scale-105 sm:h-64"
      />
      <div class="absolute inset-0 bg-linear-to-t from-slate-950/60 to-transparent" />
    </div>
  )}

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-slate-500">
          {project.tipo}
        </p>
        <h3
          class:list={[
            "mt-1 font-bold text-white transition",
            featured ? "text-xl group-hover:text-cyan-300" : "text-lg",
          ]}
        >
          {project.nombre}
        </h3>
      </div>
      <span
        class:list={[
          "shrink-0 rounded-full px-3 py-1 text-xs font-medium",
          badge.class,
        ]}
      >
        {badge.label}
      </span>
    </div>

    <div class="mt-5 space-y-4 text-sm leading-6 text-slate-400">
      <div>
        <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-slate-500">
          Problema
        </p>
        <p>{project.problema}</p>
      </div>

      <div>
        <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-slate-500">
          Aporte
        </p>
        <p class:list={[featured && "text-slate-300"]}>{project.aporte}</p>
      </div>
    </div>

    {project.stack.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {project.stack.map((tech) => (
          <Tag size="sm">{tech}</Tag>
        ))}
      </div>
    )}

    <div class="mt-auto pt-6">
      {project.evidencia && (
        <p class="mb-4 text-xs text-slate-500">{project.evidencia}</p>
      )}

      <a
        href={project.cta.disabled ? undefined : project.cta.href}
        aria-disabled={project.cta.disabled}
        tabindex={project.cta.disabled ? -1 : undefined}
        class:list={[
          "inline-flex items-center rounded-full px-5 py-2.5 text-sm font-semibold transition",
          project.cta.disabled
            ? "cursor-not-allowed border border-slate-700 text-slate-500 opacity-50"
            : "bg-cyan-400 text-slate-950 hover:bg-cyan-300",
        ]}
      >
        {project.cta.label}
      </a>
    </div>
  </div>

  {featured && (
    <div class="card-line" />
  )}
</article>
