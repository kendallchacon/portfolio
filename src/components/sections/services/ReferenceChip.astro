---
import { Icon } from "astro-icon/components";
import type { Reference } from "../../../data/services";
import { pick } from "../../../data/types";
import { experienceHref, useTranslations, type Lang } from "../../../i18n/ui";

/**
 * Referencia verificable bajo un servicio. Solo los destinos públicos son enlaces:
 * un repo privado nunca lleva href, y una experiencia sin ancla publicada es una etiqueta.
 */
interface Props {
  reference: Reference;
  lang: Lang;
}

const { reference: ref, lang } = Astro.props;
const t = useTranslations(lang);

/** Separa "nombre · detalle" por el primer separador; sin separador, la etiqueta va entera. */
function splitLabel(label: string): [string, string | undefined] {
  const i = label.indexOf(" · ");
  return i < 0 ? [label, undefined] : [label.slice(0, i), label.slice(i + 3)];
}

let icon: string;
let name: string;
let detail: string | undefined;
let href: string | undefined;
let isPrivate = false;

switch (ref.kind) {
  case "repo":
    name = ref.repo.name;
    detail = ref.detail ? pick(ref.detail, lang) : undefined;
    if (ref.repo.visibility === "public") {
      icon = "lucide:folder-git-2";
      href = ref.repo.url;
    } else {
      icon = "lucide:lock";
      isPrivate = true;
    }
    break;
  case "link":
    icon = "lucide:globe";
    [name, detail] = splitLabel(pick(ref.label, lang));
    href = ref.href;
    break;
  case "doc":
    icon = "lucide:file-text";
    [name, detail] = splitLabel(pick(ref.label, lang));
    href = ref.href;
    break;
  case "experience":
    icon = ref.icon === "pr" ? "lucide:git-pull-request" : ref.icon === "issue" ? "lucide:circle-dot" : "lucide:briefcase";
    [name, detail] = splitLabel(pick(ref.label, lang));
    href = experienceHref(ref.id, lang);
    break;
}

const base =
  "inline-flex w-fit max-w-full items-start gap-[7px] rounded-lg border border-line bg-term px-2.5 py-[5px] font-mono text-[12.5px] leading-[normal] font-medium text-ink-2";
// El nombre nunca se parte; si no cabe en una línea, el detalle baja a la segunda.
const isExternal = href?.startsWith("https://");
---

{
  href ? (
    <a
      href={href}
      rel={isExternal ? "noopener" : undefined}
      class:list={[base, "no-underline transition-colors duration-200 hover:border-accent hover:text-ink"]}
    >
      <Icon name={icon} class="mt-px size-3.5 shrink-0 text-accent *:stroke-[1.75]" aria-hidden="true" />
      <span class="flex min-w-0 flex-wrap gap-x-[0.6em]">
        <span class="whitespace-nowrap">{detail ? `${name} · ` : name}</span>
        {detail && <span class="min-w-0">{detail}</span>}
      </span>
    </a>
  ) : (
    <span class={base}>
      <Icon name={icon} class="mt-px size-3.5 shrink-0 text-accent *:stroke-[1.75]" aria-hidden="true" />
      <span class="flex min-w-0 flex-wrap gap-x-[0.6em]">
        <span class="whitespace-nowrap">{detail ? `${name} · ` : name}</span>
        {detail && <span class="min-w-0">{detail}</span>}
      </span>
      {isPrivate && (
        <>
          {" "}
          <span class="sr-only">{t("home.services.privateRepo")}</span>
        </>
      )}
    </span>
  )
}
