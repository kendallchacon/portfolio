---
/** Barra de ventana de las escenas (prototipo `.wb`), en tres tamaños. */
interface Props {
  /** `md`: código y CI (13 px). `sm`: navegadores (11 px). `xs`: pods (11,5 px). */
  size?: "md" | "sm" | "xs";
}

const { size = "md" } = Astro.props;
const pad = { md: "gap-3.5 px-4 py-3 text-[13px]", sm: "gap-2.5 px-[11px] py-[7px] text-[11px]", xs: "gap-3.5 px-3 py-2 text-[11.5px]" };
const dot = size === "sm" ? "size-2" : "size-2.5";
---

<div class:list={["flex items-center border-b border-term-line bg-term-bar font-mono leading-[normal] whitespace-nowrap text-term-ink", pad[size]]}>
  <span class="inline-flex flex-none gap-1.5" aria-hidden="true">
    <i class:list={[dot, "rounded-full bg-dot-close"]}></i>
    <i class:list={[dot, "rounded-full bg-dot-min"]}></i>
    <i class:list={[dot, "rounded-full bg-dot-max"]}></i>
  </span>
  <slot />
</div>
