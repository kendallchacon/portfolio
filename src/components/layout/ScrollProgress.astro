---
// Barra de progreso de lectura, fija arriba. Decorativa: sin JS queda en 0.
---

<div
  data-scroll-progress
  aria-hidden="true"
  style="--sp: 0"
  class="pointer-events-none fixed inset-x-0 top-0 z-80 h-0.5 origin-left scale-x-(--sp) bg-linear-to-r from-accent to-ok"
>
</div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-scroll-progress]");

  if (bar) {
    const root = document.documentElement;
    let queued = false;

    const update = () => {
      queued = false;
      const max = root.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      bar.style.setProperty("--sp", String(ratio));
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    // La altura del documento cambia al cargar fuentes e imágenes.
    new ResizeObserver(schedule).observe(document.body);
    update();
  }
</script>
