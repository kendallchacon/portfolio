---
import { Icon } from "astro-icon/components";
import ButtonLink from "../common/ButtonLink.astro";
import { featuredPreview } from "../../data/projects";
---

<section
  id="proyecto-principal"
  class="border-t border-slate-800 py-24 sm:py-32"
>
  <div class="mx-auto max-w-6xl px-0 sm:px-6">
    <!-- Header de sección -->
    <div class="reveal mb-12">
      <div class="flex items-center gap-3">
        <span class="h-px w-6 bg-cyan-400"></span>
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-400">
          {featuredPreview.eyebrow}
        </p>
      </div>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-white">
        Trabajo real en producción
      </h2>
      <p class="mt-4 max-w-2xl text-base text-slate-400">
        Un proyecto académico con impacto real — arquitectura, lógica de negocio
        y experiencia de usuario construidos en equipo.
      </p>
    </div>

    <!-- Tarjeta de preview -->
    <article
      class="reveal spotlight-card group relative overflow-hidden rounded-2xl border border-slate-700 bg-slate-900/40 transition duration-300 hover:border-cyan-400/40"
      style="transition-delay: 0.1s;"
    >
      <div class="grid lg:grid-cols-[3fr_2fr]">
        <!-- Columna izquierda: información -->
        <div class="flex flex-col justify-center p-8 md:p-12">
          <h3 class="text-2xl font-bold text-white transition group-hover:text-cyan-300">
            {featuredPreview.nombre}
          </h3>

          <p class="mt-1 text-base text-slate-400">
            {featuredPreview.subtitulo}
          </p>

          <p class="mt-4 text-sm leading-6 text-slate-300">
            Laravel + Vue + TypeScript — arquitectura modular, APIs REST y experiencia de cliente completa.
          </p>

          <!-- Métricas -->
          <div class="mt-6 flex items-center gap-0 divide-x divide-slate-700/60">
            {featuredPreview.metricas.map((m) => (
              <div class="pr-6 first:pl-0 not-first:pl-6">
                <p class="text-3xl font-bold text-cyan-400">{m.valor}</p>
                <p class="mt-0.5 text-xs uppercase tracking-wider text-slate-500">
                  {m.label}
                </p>
              </div>
            ))}
          </div>

          <!-- Stack tags con iconos -->
          <div class="mt-6 flex flex-wrap gap-2">
            {featuredPreview.stack.map((tech) => (
              <span class="flex items-center gap-1.5 rounded-full border border-slate-600/50 bg-slate-800/80 px-3 py-1 text-sm text-slate-300 transition-all duration-200 hover:border-cyan-500/50 hover:bg-slate-700/50 hover:text-cyan-300">
                {tech.icon
                  ? <Icon name={tech.icon} class:list={["h-4 w-4 shrink-0", tech.color ?? ""]} />
                  : <span class="text-cyan-400 leading-none">·</span>
                }
                {tech.label}
              </span>
            ))}
          </div>

          <div class="mt-7">
            <ButtonLink href={featuredPreview.cta.href}>
              {featuredPreview.cta.label}
            </ButtonLink>
          </div>
        </div>

        <!-- Columna derecha: imagen -->
        <div class="relative min-h-64 overflow-hidden md:min-h-80 lg:rounded-r-2xl">
          <img
            src={featuredPreview.image}
            alt={featuredPreview.imageAlt}
            class="absolute inset-0 h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
          />
          <div
            class="absolute inset-0 bg-linear-to-r from-slate-900/60 to-transparent lg:bg-linear-to-l"
          >
          </div>
        </div>
      </div>

      <div class="card-line"></div>
    </article>
  </div>
</section>
