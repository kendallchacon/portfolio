---
import CaseBuilt from "./CaseBuilt.astro";
import CaseDecisions from "./CaseDecisions.astro";
import CaseHeader from "./CaseHeader.astro";
import CaseLimits from "./CaseLimits.astro";
import CaseProblem from "./CaseProblem.astro";
import CaseShots from "./CaseShots.astro";
import CaseSpec from "./CaseSpec.astro";
import type { CaseStudy } from "../../data/cases";
import type { Project } from "../../data/projects";
import { useTranslations, type Lang } from "../../i18n/ui";

/**
 * Contenido compartido de las rutas `/proyectos/<slug>` y `/en/proyectos/<slug>`: cabecera,
 * franja de datos y "El proyecto en detalle" (problema, qué construí, capturas, decisiones y límites). La
 * estructura es la misma para todos los casos; "Capturas" se omite si el caso no tiene `shots`.
 * `data-case` activa el video de la cabecera en scripts/projects.ts (mismo observer que la
 * portada, sin el pipeline). Con reduced-motion el video no se descarga: queda el poster.
 */
interface Props {
  project: Project;
  study: CaseStudy;
  lang: Lang;
}

const { project, study, lang } = Astro.props;
const t = useTranslations(lang);
---

<article data-case data-glow aria-labelledby="case-title" class="pb-10 [--wrap-max:1120px]">
  <CaseHeader project={project} study={study} lang={lang} />
  <CaseSpec project={project} study={study} lang={lang} />

  <section id="capo" aria-labelledby="capo-title" class="pt-12 pb-6">
    <div class="wrap">
      <h2 id="capo-title" class="mb-[30px] text-[clamp(26px,2.6vw,34px)] tracking-[-0.035em]">{t("case.hood")}</h2>
      <CaseProblem problem={study.hood.problem} lang={lang} />
      <CaseBuilt built={study.hood.built} lang={lang} />
      <div>
        {
          study.hood.shots && study.hood.shots.length > 0 && (
            <CaseShots shots={study.hood.shots} note={study.hood.shotsNote} lang={lang} />
          )
        }
        <CaseDecisions items={study.hood.decisions} lang={lang} />
        <CaseLimits items={study.hood.limits} lang={lang} />
      </div>
    </div>
  </section>
</article>

<script>
  import "../../scripts/projects";
  import "../../scripts/reveal";
  import "../../scripts/glow";
  import { countUp } from "../../scripts/count";

  countUp(document);
</script>
