---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  /**
   * "legacy": estilo del sitio anterior (cian). "site": botones del diseño nuevo
   * (`.btn` / `.btn.pri` de global.css); el contenido del slot lleva su icono y su texto.
   * TODO iteración 7: al borrar las páginas legacy se invierte el valor por defecto
   * a "site" y se elimina esta prop.
   */
  tone?: "legacy" | "site";
  download?: boolean | string;
  target?: string;
  rel?: string;
  class?: string;
}

const {
  href,
  variant = "primary",
  tone = "legacy",
  download,
  target,
  rel = target === "_blank" ? "noreferrer" : undefined,
  class: className = "",
} = Astro.props;

const baseClass =
  "inline-flex items-center justify-center rounded-full px-6 py-3 text-center text-sm font-semibold transition focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950";
const variantClass =
  variant === "primary"
    ? "btn-primary-animated bg-(--accent) text-white hover:brightness-110"
    : "border border-slate-700 text-slate-200 hover:border-(--accent) hover:text-(--accent)";
const siteClass = variant === "primary" ? "btn pri" : "btn";
---

<a
  href={href}
  download={download}
  target={target}
  rel={rel}
  class:list={tone === "site" ? [siteClass, className] : [baseClass, variantClass, className]}
>
  {tone === "site" ? <slot /> : <span><slot /></span>}
</a>
