---
import { Icon } from "astro-icon/components";
import ButtonLink from "../common/ButtonLink.astro";
import Tag from "../common/Tag.astro";
import { contactFull } from "../../data/contact";
---

<section id="contact" class="border-t border-slate-800 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-0 sm:px-6">

    <div class="grid items-start gap-14 lg:grid-cols-2">

      <!-- Columna izquierda -->
      <div class="reveal">
        <div class="flex items-center gap-3">
          <span class="h-px w-6 bg-cyan-400"></span>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-400">
            Contacto
          </p>
        </div>

        <h1 class="mt-4 text-4xl font-bold tracking-tight text-white">
          {contactFull.titulo}
        </h1>

        <p class="mt-4 max-w-md text-lg leading-8 text-slate-300">
          {contactFull.descripcion}
        </p>

        <p class="mt-4 text-sm text-slate-400">{contactFull.disponibilidad}</p>

        <div class="mt-4 flex flex-wrap gap-2">
          {contactFull.chips.map((chip) => (
            <Tag size="sm" featured={chip.featured}>{chip.label}</Tag>
          ))}
        </div>

        <div class="mt-8">
          <ButtonLink href={contactFull.ctaPrincipal.href}>
            {contactFull.ctaPrincipal.label}
          </ButtonLink>
        </div>

        <div class="mt-4">
          <a
            href={contactFull.ctaSecundario.href}
            download
            class="text-sm text-slate-400 underline-offset-4 transition-colors hover:text-slate-300 hover:underline"
          >
            {contactFull.ctaSecundario.label}
          </a>
        </div>
      </div>

      <!-- Columna derecha — canales -->
      <div class="reveal" style="transition-delay: 0.15s;">
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500">
          {contactFull.canalesTitulo}
        </p>

        <div class="flex flex-col gap-3">
          {contactFull.canales.map((canal) => (
            <a
              href={canal.href}
              target={canal.external ? "_blank" : undefined}
              rel={canal.external ? "noreferrer" : undefined}
              class="group flex items-center gap-4 rounded-xl border border-slate-700/50 bg-slate-900/50 p-4 transition-all duration-300 hover:translate-x-1 hover:border-cyan-500/40"
            >
              <Icon
                name={canal.icon}
                class:list={["size-5 shrink-0 transition duration-300 group-hover:scale-110", canal.iconClass]}
              />
              <div>
                <p class="font-semibold text-white">{canal.label}</p>
                <p class="text-sm text-slate-400">{canal.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bloque de cierre -->
    <p class="reveal mt-16 text-center text-sm text-slate-500" style="transition-delay: 0.1s;">
      {contactFull.cierreTexto}
    </p>

  </div>
</section>
