---
import type { TerminalLine, TerminalStatusBar } from "../../data/hero";

interface Props {
  fileName: string;
  lines: TerminalLine[];
  statusBar: TerminalStatusBar;
}

const { fileName, lines, statusBar } = Astro.props;

const toneClass: Record<NonNullable<TerminalLine["tone"]>, string> = {
  default: "text-slate-200",
  accent: "text-(--accent)",
  success: "text-emerald-300",
  muted: "text-slate-500",
};
---

{/*
  Terminal de presentación (elemento dominante de la columna derecha).
  - Todo el contenido (typing y status bar) vive en el DOM, por lo que es legible
    sin JavaScript y para SEO/lectores de pantalla.
  - Con JS, site-interactions.js tipea las líneas una sola vez. Respeta
    prefers-reduced-motion mostrando todo de forma estática.
  - data-terminal-state="idle" permite a global.css ocultar el texto antes del
    tipeo SOLO cuando hay JS (html.js), evitando el parpadeo inicial.
  - Altura natural en mobile (sin corte de contenido). En desktop la columna
    estira la tarjeta (items-stretch) y min-h-120 actúa de suelo. El
    overflow-hidden del root es solo para recortar a las esquinas redondeadas y
    contener el glow del spotlight, no el contenido.
*/}
<div
  data-terminal
  data-terminal-state="idle"
  data-spotlight
  class="terminal-card spotlight-card group relative flex h-full w-full flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-950/90 lg:min-h-120"
>
  <!-- Header de la ventana -->
  <div
    class="flex items-center gap-2 border-b border-slate-800 bg-slate-900/40 px-5 py-3.5"
  >
    <span class="h-3 w-3 rounded-full bg-red-400/90" aria-hidden="true"></span>
    <span class="h-3 w-3 rounded-full bg-yellow-400/90" aria-hidden="true"></span>
    <span class="h-3 w-3 rounded-full bg-green-400/90" aria-hidden="true"></span>
    <span class="ml-auto font-mono text-xs text-slate-400">{fileName}</span>
  </div>

  <!-- Cuerpo: typing. Altura natural; el contenido nunca se corta. -->
  <div
    class="flex-1 p-5 font-mono text-[13px] leading-relaxed sm:text-sm"
  >
    <div data-terminal-lines class="space-y-1">
      {
        lines.map((line) =>
          line.kind === "blank" ? (
            <p class="term-line term-line--blank" aria-hidden="true" />
          ) : (
            <p
              class="term-line flex"
              style={`padding-left: ${(line.indent ?? 0) * 1.25}rem`}
            >
              <span
                class:list={[
                  "term-prompt mr-2 shrink-0 select-none",
                  line.kind === "command" ? "text-(--accent-bright)" : "text-slate-600",
                ]}
                aria-hidden="true"
              >
                {line.kind === "command" ? "$" : ">"}
              </span>
              <span class={`term-txt ${toneClass[line.tone ?? "default"]}`}>
                {line.text}
              </span>
              <span class="term-cursor" aria-hidden="true" />
            </p>
          ),
        )
      }
    </div>
  </div>

  <!-- Status bar permanente (FASE 2) -->
  <div
    class="term-statusbar flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-slate-800 bg-slate-900/60 px-5 py-2.5 font-mono text-[11px] text-slate-400"
  >
    <span class="flex items-center gap-1.5 font-medium text-emerald-300">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"
      ></span>
      {statusBar.state}
    </span>
    {
      statusBar.segments.map((segment) => (
        <>
          <span class="text-slate-700" aria-hidden="true">
            ·
          </span>
          <span>{segment}</span>
        </>
      ))
    }
  </div>
</div>
