---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import CommandPalette from "../components/layout/CommandPalette.astro";
import ScrollProgress from "../components/layout/ScrollProgress.astro";
import { alternateUrls, ogLocale, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "profile" | "article";
  /**
   * "full": el <main> no limita el ancho (cada sección decide el suyo).
   * "legacy": páginas del sitio anterior, con <main> acotado y page-enter. Se borra con ellas.
   */
  layout?: "legacy" | "full";
}

const {
  lang = "es",
  image = "/images/project-preview.jpg",
  type = "website",
  layout = "full",
} = Astro.props;
const t = useTranslations(lang);
const { title = t("meta.title"), description = t("meta.description") } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(image, Astro.site).toString();
const alternates = alternateUrls(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    {/* Marca temprano que hay JS para permitir el anti-parpadeo de la terminal
        sin penalizar a quien navega sin JavaScript. `rv` habilita el reveal por scroll
        solo si existe IntersectionObserver (sin él, nada se oculta). */}
    <script is:inline>document.documentElement.classList.add("js");if("IntersectionObserver"in window)document.documentElement.classList.add("rv");</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kendall Chacón" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={alternates.es} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates["x-default"]} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={t("meta.siteName")} />
    <meta property="og:locale" content={ogLocale[lang]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.svg" />
  </head>

  <body class="overflow-x-hidden bg-bg text-ink antialiased">
    <a href="#main-content" class="skip-link">{t("a11y.skipLink")}</a>

    <ScrollProgress />

    <div class="min-h-screen flex flex-col">
      <Navbar lang={lang} />

      {/* El navbar es fijo y flotante: el <main> legacy deja su altura libre arriba. */}
      <main
        id="main-content"
        tabindex="-1"
        class:list={[
          "flex-1 outline-none",
          layout === "legacy" &&
            "w-full max-w-6xl mx-auto px-4 sm:px-6 pt-[calc(var(--header-h)+1rem)] page-enter",
        ]}
      >
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <CommandPalette />
    <script src="../scripts/site-interactions.js"></script>
  </body>
</html>
