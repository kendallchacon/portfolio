---
import ButtonLink from "../common/ButtonLink.astro";
import { contactCompact } from "../../data/contact";
---

<section class="reveal border-t border-slate-800 py-24 sm:py-32">
  <div class="mx-auto max-w-2xl px-0 text-center sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-white">
      {contactCompact.titulo}
    </h2>
    <p class="mt-2 text-lg text-slate-400">
      {contactCompact.subtitulo}
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      {contactCompact.ctas.map((cta) => (
        <ButtonLink
          href={cta.href}
          variant={cta.variant}
          target={cta.external ? "_blank" : undefined}
        >
          {cta.label}
        </ButtonLink>
      ))}
    </div>
  </div>
</section>
