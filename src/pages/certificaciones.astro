---
import BaseLayout from "../layouts/BaseLayout.astro";
import CertificationCard from "../components/sections/CertificationCard.astro";
import { certifications, cierreTexto } from "../data/certifications";
---

<BaseLayout
  title="Certificaciones | Kendall Chacón"
  description="Certificaciones y formación de Kendall Chacón: Scrum, diplomado y credenciales técnicas en desarrollo de software."
>
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-0 sm:px-6">

      <!-- Header -->
      <div class="reveal max-w-2xl">
        <div class="flex items-center gap-3">
          <span class="h-px w-6 bg-cyan-400"></span>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-400">
            Certificaciones
          </p>
        </div>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-white md:text-5xl">
          Aprendizaje continuo
        </h1>
        <p class="mt-4 text-lg text-slate-400">
          Formación verificable que complementa mi experiencia práctica.
        </p>
      </div>

      <!-- Grid de certificados -->
      <div class="mt-12 grid items-stretch gap-6 md:grid-cols-2">
        {certifications.map((cert, i) => (
          <CertificationCard cert={cert} delay={i * 0.1} />
        ))}
      </div>

      <!-- Bloque de cierre -->
      <p class="reveal mt-12 text-center text-sm text-slate-500">
        {cierreTexto}
      </p>

    </div>
  </section>
</BaseLayout>
