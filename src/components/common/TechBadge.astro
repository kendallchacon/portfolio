---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  icon: string;
  color?: string;
  compact?: boolean;
}

const { name, icon, color = "text-(--accent)", compact = false } = Astro.props;
---

<div class:list={["group", !compact && "relative"]}>
  <div
    class:list={[
      "flex items-center gap-3 border border-slate-800 bg-slate-950/50 text-slate-300 transition group-hover:border-(--accent)/40 group-hover:bg-slate-900/70 group-hover:text-(--accent)",
      compact
        ? "rounded-full px-3 py-2 text-sm"
        : "rounded-2xl p-4 group-hover:-translate-y-1",
    ]}
  >
    <div
      class:list={[
        "flex items-center justify-center transition group-hover:scale-110",
        compact
          ? ""
          : "h-11 w-11 rounded-2xl border border-slate-800 bg-slate-900/70 group-hover:border-(--accent)/40",
      ]}
    >
      <Icon name={icon} class:list={[compact ? "size-5" : "size-6", color]} />
    </div>

    <span class="font-medium">{name}</span>
  </div>
</div>

