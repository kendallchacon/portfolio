---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  titleTag?: "h1" | "h2";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  titleTag = "h2",
  class: className = "",
} = Astro.props;
const TitleTag = titleTag;
---

<div class={className}>
  <div class="flex items-center gap-3">
    <span class="h-px w-6 bg-cyan-400"></span>
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-400">
      {eyebrow}
    </p>
  </div>

  <TitleTag
    class:list={[
      "mt-4 font-bold tracking-tight text-white",
      titleTag === "h1" ? "text-4xl sm:text-5xl" : "text-3xl sm:text-4xl",
    ]}
  >
    {title}
  </TitleTag>

  {
    description && (
      <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-400">
        {description}
      </p>
    )
  }
</div>

