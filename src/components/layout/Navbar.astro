---
import { Icon } from "astro-icon/components";
import { contact } from "../../data/contact";
import { pick } from "../../data/types";
import { navSections, sectionHref, useTranslations, type Lang } from "../../i18n/ui";
import LangSwitch from "./LangSwitch.astro";
import MobileMenu from "./MobileMenu.astro";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
const cv = contact.channels.find((channel) => channel.id === "cv");
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-70 px-3 pt-2.5">
  {/* El fondo con blur va en ::before: un backdrop-filter en el contenedor haría de bloque
      contenedor de la hoja móvil (position: fixed) y la descolocaría. */}
  <div
    class="pointer-events-auto relative isolate mx-auto flex h-13.5 w-full max-w-310 items-center gap-3.5 pr-2 pl-2.5 before:absolute before:inset-0 before:-z-10 before:rounded-full before:border before:border-line before:bg-surface-1/70 before:backdrop-blur-xl before:backdrop-saturate-150"
  >
    <a
      href={sectionHref("inicio", lang)}
      aria-label={t("nav.home")}
      class="flex min-h-11 items-center gap-2.5 rounded-full font-mono text-[15px] font-semibold tracking-tight whitespace-nowrap"
    >
      <span class="grid size-8.5 place-items-center rounded-full bg-ink text-bg" aria-hidden="true">
        <Icon name="heroicons:command-line" class="size-4.5" />
      </span>
      <span>{t("nav.brand")}</span>
    </a>

    <nav data-nav aria-label={t("nav.label")} class="relative mx-auto hidden min-[980px]:block">
      <ul class="flex gap-0.5">
        {
          navSections.map((id) => (
            <li>
              <a
                href={sectionHref(id, lang)}
                data-section={id}
                class="relative z-10 block rounded-full px-2.75 py-2 text-[14.5px] font-medium text-ink-2 transition-colors hover:text-ink aria-[current=location]:text-ink min-[1100px]:px-3.75"
              >
                {t(`nav.${id}`)}
              </a>
            </li>
          ))
        }
      </ul>
      <i
        data-nav-indicator
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 left-0 z-0 h-8.5 w-0 rounded-full bg-surface-3 opacity-0 transition-[transform,width,opacity] duration-450 ease-brand motion-reduce:transition-none"
      >
      </i>
    </nav>

    <div class="ml-auto flex items-center gap-2 min-[980px]:ml-0">
      {/* Solo con JS (html.js) y en escritorio; en móvil la paleta se abre desde el menú.
          Desde 1280 px el botón pasa a w-56 (224 px) y crece hacia la izquierda: el -ml-32
          (128 px) compensa lo que suma sobre la versión compacta (~96 px) para que el <nav>,
          centrado entre el logo y estas herramientas, no se desplace. */}
      <button
        type="button"
        data-open-palette
        aria-haspopup="dialog"
        aria-keyshortcuts="Control+K Meta+K"
        aria-label={t("palette.open")}
        class="hidden cursor-pointer items-center gap-2 rounded-full border border-line px-3 py-1.5 text-ink-2 transition-colors hover:border-line-strong hover:text-ink min-[1100px]:pr-1.5 min-[1280px]:-ml-32 min-[1280px]:w-56 [.js_&]:min-[980px]:inline-flex"
      >
        <Icon name="heroicons:magnifying-glass" class="size-4 shrink-0" aria-hidden="true" />
        {/* Texto visible solo desde 1280 px; su nombre ya está en el aria-label del botón. */}
        <span aria-hidden="true" class="hidden flex-1 text-left text-sm text-ink-2 min-[1280px]:block">
          {t("nav.search")}
        </span>
        <kbd
          data-kbd
          aria-hidden="true"
          class="hidden min-w-13 rounded-md bg-surface-3 px-1.5 py-0.5 text-center font-mono text-[11px] font-medium min-[1100px]:inline-block"
        >
          Ctrl K
        </kbd>
      </button>
      <LangSwitch lang={lang} />
      {
        cv && (
          <a
            href={cv.href}
            download
            aria-label={`${pick(cv.label, lang)}: ${pick(cv.value, lang)}`}
            class="btn pri sm hidden min-[980px]:inline-flex"
          >
            <Icon name={cv.icon} class="size-4 shrink-0" aria-hidden="true" />
            <span>{pick(cv.label, lang)}</span>
          </a>
        )
      }
      <MobileMenu lang={lang} />
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const indicator = nav?.querySelector<HTMLElement>("[data-nav-indicator]");

  if (nav && indicator) {
    const links = new Map(
      Array.from(nav.querySelectorAll<HTMLAnchorElement>("a[data-section]")).map((a) => [a.dataset.section!, a]),
    );
    // Todas las secciones de la página, en orden del documento. Las que no tienen enlace
    // (inicio, sobre-mi) ceden el indicador a la sección con enlace anterior, si la hay.
    const sections = Array.from(document.querySelectorAll<HTMLElement>("main section[id]"));
    let current: HTMLAnchorElement | undefined;
    let placed = false;

    const place = () => {
      if (!current) {
        indicator.style.opacity = "0";
        return;
      }
      // Primera colocación: sin deslizar desde el origen.
      if (!placed) indicator.style.transition = "none";
      indicator.style.opacity = "1";
      indicator.style.width = `${current.offsetWidth}px`;
      indicator.style.transform = `translate(${current.offsetLeft}px, -50%)`;
      if (!placed) {
        void indicator.offsetWidth;
        indicator.style.transition = "";
        placed = true;
      }
    };

    const setCurrent = (link: HTMLAnchorElement | undefined) => {
      current = link;
      links.forEach((a) => {
        if (a === link) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
      place();
    };

    if (sections.length) {
      const reached = new Set<Element>();
      // Franja del 40 % superior del viewport: la sección vigente es la última que la toca.
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? reached.add(e.target) : reached.delete(e.target)));
          let link: HTMLAnchorElement | undefined;
          for (let i = sections.findLastIndex((s) => reached.has(s)); i >= 0 && !link; i--) {
            link = links.get(sections[i].id);
          }
          setCurrent(link);
        },
        { rootMargin: "0px 0px -60% 0px" },
      );
      sections.forEach((s) => observer.observe(s));
    }

    // El ancho de los enlaces cambia al cargar la fuente y al redimensionar.
    new ResizeObserver(place).observe(nav);
    document.fonts?.ready.then(place);
  }
</script>
