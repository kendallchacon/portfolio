---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import { betoYMas, projects } from "../data/legacy/projects";
import { SITE_CONFIG } from "../data/legacy/config";

const carouselSlides = betoYMas.galeria;

const allProjects = [
  {
    id: "beto",
    numero: "01",
    numeroLabel: "PROYECTO PRINCIPAL",
    lineColor: "bg-(--accent)",
    textColor: "text-(--accent)",
    nombre: betoYMas.nombre,
    subtitulo: "Plataforma web de fidelización, juegos y recompensas",
    periodo: betoYMas.periodo,
    stack: betoYMas.stack,
    badges: [
      { label: "Completado", class: "border border-(--accent)/30 bg-(--accent)/10 text-(--accent)" },
      { label: "Proyecto académico", class: "border border-slate-600/40 bg-slate-700/60 text-slate-300" },
    ],
    isBeto: true,
  },
  {
    id: "movil",
    numero: "02",
    numeroLabel: "EN DESARROLLO",
    lineColor: "bg-slate-500",
    textColor: "text-slate-500",
    nombre: "Aplicación móvil",
    subtitulo: projects[1].tipo,
    periodo: null,
    stack: projects[1].stack.map((s) => ({ label: s, icon: null, color: null })),
    badges: [
      { label: "En desarrollo", class: "border border-yellow-500/30 bg-yellow-500/10 text-yellow-400" },
    ],
    isBeto: false,
  },
  {
    id: "personal",
    numero: "03",
    numeroLabel: "PRÓXIMAMENTE",
    lineColor: "bg-slate-600",
    textColor: "text-slate-600",
    nombre: "Proyecto personal",
    subtitulo: projects[2].tipo,
    periodo: null,
    stack: [],
    badges: [
      { label: "Próximamente", class: "border border-slate-500/30 bg-slate-500/10 text-slate-400" },
    ],
    isBeto: false,
  },
];
---

<BaseLayout
  layout="legacy"
  title="Proyectos | Kendall Chacón"
  description="Proyectos reales con problema definido, aporte individual verificable y decisiones técnicas explicables."
  image="/images/beto-landing.jpg"
>
  <!-- SECCIÓN 1 — Header -->
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-0 sm:px-6">
      <div class="reveal max-w-2xl">
        <div class="flex items-center gap-3">
          <span class="h-px w-6 bg-(--accent)"></span>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-(--accent)">
            Proyectos
          </p>
        </div>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-white md:text-5xl">
          Proyectos construidos para resolver problemas reales.
        </h1>
        <p class="mt-4 text-lg text-slate-400">
          Cada proyecto documenta el problema, mi contribución individual y
          las decisiones técnicas detrás de la solución.
        </p>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 2 — Acordeón de proyectos -->
  <section class="border-t border-slate-800 pb-24 sm:pb-32">
    <div class="mx-auto max-w-6xl px-0 sm:px-6">
      <div class="divide-y divide-slate-800" data-accordion>

        {allProjects.map((proj) => (
          <div class="reveal">

            <!-- HEADER -->
            <button
              type="button"
              data-accordion-trigger
              aria-expanded="false"
              aria-controls={`project-${proj.id}`}
              class="group relative w-full cursor-pointer px-0 py-6 text-left transition-colors duration-200 hover:bg-slate-800/30 sm:px-4"
            >
              <div class="flex items-center justify-between gap-4">
                <!-- Lado izquierdo -->
                <div class="flex-1">
                  <!-- Número -->
                  <div class="mb-3 flex items-center gap-3">
                    <span class:list={["h-px w-8 shrink-0", proj.lineColor]}></span>
                    <p class:list={["text-xs uppercase tracking-widest", proj.textColor]}>
                      {proj.numero} — {proj.numeroLabel}
                    </p>
                  </div>

                  <!-- Título y badges -->
                  <div class="flex flex-wrap items-center gap-3">
                    <h2 class="text-2xl font-bold text-white md:text-3xl">{proj.nombre}</h2>
                    {proj.badges.map((b) => (
                      <span class:list={["shrink-0 rounded-full px-3 py-1 text-xs font-medium", b.class]}>
                        {b.label}
                      </span>
                    ))}
                  </div>

                  <!-- Subtítulo -->
                  {proj.subtitulo && (
                    <p class="mt-1 text-sm text-slate-500">{proj.subtitulo}</p>
                  )}

                  <!-- Stack tags -->
                  {proj.stack.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-2">
                      {proj.stack.map((tech) => (
                        <span class="flex items-center gap-1.5 rounded-full border border-slate-600/50 bg-slate-800/80 px-3 py-1 text-sm text-slate-300">
                          {tech.icon
                            ? <Icon name={tech.icon} class:list={["h-4 w-4 shrink-0", tech.color ?? ""]} />
                            : null
                          }
                          {tech.label}
                        </span>
                      ))}
                    </div>
                  )}
                </div>

                <!-- Lado derecho — chevron -->
                <Icon
                  name="heroicons:chevron-down"
                  class="size-5 shrink-0 text-slate-400 transition-transform duration-300 group-aria-expanded:rotate-180"
                />
              </div>
            </button>

            <!-- CONTENIDO DESPLEGABLE -->
            <div
              id={`project-${proj.id}`}
              data-accordion-content
              role="region"
              class="overflow-hidden transition-all duration-500 ease-in-out"
              style="max-height: 0; opacity: 0;"
            >
              <div class="px-0 pb-8 pt-6 sm:px-4">
                {proj.isBeto ? (
                  <div class="space-y-12">

                    <!-- CTA externo -->
                    <div>
                      <a
                        href={SITE_CONFIG.betoYMas}
                        target="_blank"
                        rel="noreferrer"
                        class="text-sm text-(--accent) underline-offset-4 transition-colors hover:underline"
                      >
                        Ver proyecto →
                      </a>
                      <p class="mt-1 text-xs text-slate-500">
                        Plataforma activa · Requiere registro para el sistema completo
                      </p>
                    </div>

                    <!-- Problema y solución -->
                    <div class="grid gap-6 md:grid-cols-2">
                      <div class="group relative overflow-hidden rounded-2xl border border-slate-700/50 bg-slate-900/50 p-6">
                        <p class="text-xs font-semibold uppercase tracking-wider text-(--accent)">Problema</p>
                        <p class="mt-3 text-sm leading-7 text-slate-300">{betoYMas.problema}</p>
                        <div class="card-line"></div>
                      </div>
                      <div class="group relative overflow-hidden rounded-2xl border border-slate-700/50 bg-slate-900/50 p-6">
                        <p class="text-xs font-semibold uppercase tracking-wider text-(--accent)">Solución</p>
                        <p class="mt-3 text-sm leading-7 text-slate-300">{betoYMas.solucion}</p>
                        <div class="card-line"></div>
                      </div>
                    </div>

                    <!-- Mi aporte individual -->
                    <div>
                      <h3 class="text-xl font-semibold text-white">Mi aporte individual</h3>
                      <div class="mt-6 grid items-stretch gap-4 md:grid-cols-2">
                        {betoYMas.contribuciones.map((c, i) => (
                          <div class="group relative h-full">
                            <div class="card-glow-hover-nested relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-800 bg-slate-900/40 p-4 transition duration-300 group-hover:-translate-y-1 group-hover:bg-slate-900/70">
                              <div class="flex grow items-start gap-3">
                                <span class="shrink-0 text-lg font-bold tabular-nums leading-tight text-(--accent)">
                                  {String(i + 1).padStart(2, "0")}
                                </span>
                                <div class="flex flex-col">
                                  <h4 class="shrink-0 text-sm font-semibold text-white">{c.titulo}</h4>
                                  <p class="mt-1 grow line-clamp-3 text-sm leading-6 text-slate-300">
                                    {c.descripcion}
                                  </p>
                                </div>
                              </div>
                              <div class="card-line"></div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>

                    <!-- Carrusel -->
                    <div>
                      <h3 class="text-xl font-semibold text-white">Vistas del sistema</h3>
                      <div
                        class="relative mt-6 h-105 w-full overflow-hidden rounded-2xl md:h-130"
                        data-carousel
                        aria-label="Galería de capturas de Beto y Más"
                      >
                        {carouselSlides.map((slide, i) => (
                          <div
                            data-carousel-slide
                            class="absolute inset-0 h-full w-full"
                            style={`opacity: ${i === 0 ? 1 : 0};`}
                          >
                            <img
                              src={slide.imagen}
                              alt={slide.titulo}
                              loading={i === 0 ? "eager" : "lazy"}
                              fetchpriority={i === 0 ? "high" : undefined}
                              decoding={i === 0 ? undefined : "async"}
                              class="h-full w-full object-cover"
                            />
                            <div class="absolute inset-0 bg-linear-to-t from-slate-950/80 via-transparent to-transparent" />
                            <div class="absolute bottom-0 p-6">
                              <p class="text-lg font-semibold text-(--accent)">{slide.titulo}</p>
                              <p class="mt-1 text-sm text-slate-200">{slide.descripcion}</p>
                            </div>
                          </div>
                        ))}
                        <div class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 items-center gap-2 rounded-full bg-slate-950/50 px-3 py-1.5 backdrop-blur-sm">
                          {carouselSlides.map((_, i) => (
                            <button
                              data-carousel-dot
                              type="button"
                              aria-label={`Ir a imagen ${i + 1}`}
                              class="h-2 rounded-full bg-white transition-all duration-300"
                              style={`width: ${i === 0 ? "1.5rem" : "0.5rem"}; opacity: ${i === 0 ? 1 : 0.4};`}
                            />
                          ))}
                        </div>
                      </div>
                    </div>

                    <!-- Decisiones técnicas -->
                    <div>
                      <h3 class="text-xl font-semibold text-white">Decisiones técnicas</h3>
                      <div class="mt-6 grid gap-4 md:grid-cols-2">
                        {betoYMas.decisiones.map((d) => (
                          <div class="card-glow-hover border-l-2 border-(--accent) py-2 pl-4">
                            <h4 class="text-sm font-semibold text-white">{d.titulo}</h4>
                            <p class="mt-1 line-clamp-2 text-sm leading-6 text-slate-400">{d.descripcion}</p>
                          </div>
                        ))}
                      </div>
                    </div>

                  </div>
                ) : (
                  <p class="py-8 text-center text-sm text-slate-500">
                    Documentación disponible próximamente.
                  </p>
                )}
              </div>
            </div>

          </div>
        ))}

      </div>
    </div>
  </section>
</BaseLayout>
