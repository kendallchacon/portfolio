---
import { languages } from "../../data/profile";
import { languageSwitchUrl, useTranslations, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
---

<div
  role="group"
  aria-label={t("lang.group")}
  class:list={["flex rounded-full border border-line bg-surface-2 p-0.5", className]}
>
  {
    languages.map((l) => (
      <a
        href={languageSwitchUrl(pathname, l.code)}
        lang={l.code}
        hreflang={l.code}
        aria-label={l.name}
        aria-current={l.code === lang ? "true" : undefined}
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-2.5 text-xs font-semibold text-ink-2 transition-colors hover:text-ink aria-[current=true]:bg-ink aria-[current=true]:text-bg min-[980px]:min-h-0 min-[980px]:min-w-0 min-[980px]:py-1.5"
      >
        {l.code.toUpperCase()}
      </a>
    ))
  }
</div>
