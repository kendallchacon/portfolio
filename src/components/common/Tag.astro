---
interface Props {
  featured?: boolean;
  size?: "sm" | "md";
}

const { featured = false, size = "md" } = Astro.props;
---

<span
  class:list={[
    "rounded-full border transition",
    size === "sm" ? "px-3 py-1 text-xs" : "px-4 py-2",
    featured
      ? "border-(--accent)/30 bg-(--accent)/10 text-(--accent)"
      : "border-slate-700 bg-slate-900/50 text-slate-400 hover:border-(--accent) hover:text-(--accent)",
  ]}
>
  <slot />
</span>

