---
import type { Certification } from "../../data/certifications";

interface Props {
  cert: Certification;
  delay?: number;
}

const { cert, delay } = Astro.props;
---

<article
  class="reveal card-glow-hover group relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-700/50 bg-slate-900/50"
  style={delay !== undefined ? `transition-delay: ${delay}s;` : undefined}
>
  <!-- Imagen -->
  {cert.imagen && (
    <div class="overflow-hidden">
      <img
        src={cert.imagen}
        alt={cert.nombre}
        loading="lazy"
        decoding="async"
        class="aspect-3/2 w-full object-cover object-top transition-transform duration-500 hover:scale-[1.02]"
      />
    </div>
  )}

  <!-- Contenido -->
  <div class="flex flex-1 flex-col p-6">
    <!-- Emisor con línea decorativa -->
    <div class="flex items-center gap-3">
      <span class="h-px w-5 bg-(--accent)"></span>
      <p class="text-xs font-semibold uppercase tracking-wider text-(--accent)">
        {cert.emisor}
      </p>
    </div>

    {cert.facultad && (
      <p class="mt-1 text-xs text-slate-500">{cert.facultad}</p>
    )}

    <h2 class="mt-2 text-xl font-bold text-white">{cert.nombre}</h2>

    <p class="mt-1 text-sm text-slate-500">
      {cert.fecha}
      {cert.lugar && <span> · {cert.lugar}</span>}
    </p>

    <div class="my-4 border-t border-slate-700/50"></div>

    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
      Competencia demostrada
    </p>
    <p class="mt-1 text-sm leading-relaxed text-slate-300">{cert.competencia}</p>

    {cert.id && (
      <p class="mt-3 text-xs text-slate-600">ID: {cert.id}</p>
    )}

  </div>
  <span class="card-line"></span>
</article>
