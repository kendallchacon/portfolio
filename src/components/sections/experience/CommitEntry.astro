---
import { Icon } from "astro-icon/components";
import { Image, getImage } from "astro:assets";
import TechLogo from "../../common/TechLogo.astro";
import type { experienceLog } from "../../../data/experience";
import { tech } from "../../../data/tech";
import { pick } from "../../../data/types";
import { useTranslations, type Lang } from "../../../i18n/ui";

/**
 * Un commit del git log de experiencia. El hash es decorativo (`aria-hidden`).
 * Los KPIs ya traen su valor final en el HTML; experience.ts solo los anima.
 * Los adjuntos son enlaces a la imagen completa: sin JS se abren tal cual, con JS en el visor.
 */
interface Props {
  entry: (typeof experienceLog)[number];
  lang: Lang;
  first: boolean;
}

const { entry, lang, first } = Astro.props;
const t = useTranslations(lang);

// Las imágenes viven en src/assets/experience/ (no en docs/): el build no depende del prototipo.
const assets = import.meta.glob<{ default: ImageMetadata }>("../../../assets/experience/*.{jpg,jpeg,png,webp}", {
  eager: true,
});
const attachments = await Promise.all(
  (entry.attachments ?? []).flatMap((ref) => {
    const src = assets[`../../../assets/experience/${ref.file}`]?.default;
    if (!src) return [];
    return [
      getImage({ src, format: "webp", quality: 75, width: Math.min(src.width, 1600) }).then((full) => ({
        src,
        full,
        alt: pick(ref.alt, lang),
      })),
    ];
  }),
);

// Logo de la organización: PNG/JPG/WebP o SVG, siempre como imagen (no inline).
const logos = import.meta.glob<{ default: ImageMetadata }>("../../../assets/experience/logos/*.{png,jpg,webp,svg}", {
  eager: true,
});
const logo = entry.logo ? logos[`../../../assets/experience/logos/${entry.logo}`]?.default : undefined;
// Tile de 92×46 con padding 6×8 (como `.org-logo` del prototipo): la imagen ocupa los 76 px de ancho.
const logoW = 76;
const logoH = logo ? Math.round((logoW * logo.height) / logo.width) : 0;

const date = pick(entry.date, lang);
const nf = (decimals = 0) =>
  new Intl.NumberFormat(lang, { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
---

<li
  id={`xp-${entry.id}`}
  data-b={entry.branch}
  data-rv="x"
  style={`--bc:var(--color-branch-${entry.branch})`}
  class:list={[
    "relative mb-3 grid scroll-mt-[60px] grid-cols-1 gap-5 rounded-2 border p-[18px] transition-colors duration-250 hover:border-line-strong min-[980px]:scroll-mt-0 min-[980px]:px-6 min-[980px]:py-[22px]",
    first
      ? "border-[color-mix(in_srgb,var(--color-accent)_35%,transparent)] bg-[linear-gradient(135deg,color-mix(in_srgb,var(--color-accent)_12%,transparent),var(--color-surface-1)_60%)]"
      : "border-line bg-surface-1",
    attachments.length > 0 && "min-[980px]:grid-cols-[1fr_168px]",
  ]}
>
  <span
    aria-hidden="true"
    class:list={[
      "absolute top-[26px] -left-7 size-4 rounded-full border-[3px] border-(--bc) shadow-[0_0_0_4px_var(--color-bg)] min-[980px]:-left-9",
      first ? "bg-(--bc)" : "bg-bg",
    ]}
  ></span>

  <div class="min-w-0">
    <div class="mb-2.5 flex flex-wrap items-center gap-2 font-mono text-[13px] leading-[normal]">
      <code aria-hidden="true" class="text-warn">{entry.hash}</code>
      {
        first && (
          <span
            aria-hidden="true"
            class="rounded-full border border-[color-mix(in_srgb,var(--color-accent)_50%,transparent)] bg-[color-mix(in_srgb,var(--color-accent)_12%,transparent)] px-[9px] py-px text-accent"
          >
            HEAD → main
          </span>
        )
      }
      <span class="rounded-full border border-[color-mix(in_srgb,var(--bc)_50%,transparent)] bg-[color-mix(in_srgb,var(--bc)_12%,transparent)] px-[9px] py-px text-(--bc)">
        {t(`home.xp.branch.${entry.branch}`)}
      </span>
      {date && <span class="text-ink-2 max-[979px]:w-full min-[980px]:ml-auto">{date}</span>}
    </div>

    {
      logo ? (
        <div class="flex items-center gap-3.5">
          <span class="grid h-[46px] w-[92px] shrink-0 place-items-center rounded-[10px] bg-paper px-2 py-1.5">
            <Image
              src={logo}
              alt=""
              width={logoW}
              height={logoH}
              densities={[1.5, 2, 3]}
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
            />
          </span>
          <div class="min-w-0">
            <h3 class="text-[20px] tracking-[-0.02em]">{pick(entry.title, lang)}</h3>
            <p class="mt-0.5 text-[15px] text-ink-2">{pick(entry.subtitle, lang)}</p>
          </div>
        </div>
      ) : (
        <>
          <h3 class="text-[20px] tracking-[-0.02em]">{pick(entry.title, lang)}</h3>
          <p class="mt-0.5 text-[15px] text-ink-2">{pick(entry.subtitle, lang)}</p>
        </>
      )
    }
    <p class="mt-2.5 max-w-[66ch] text-base text-ink-soft">{pick(entry.body, lang)}</p>

    {
      entry.kpis && (
        <dl class="mt-4 flex flex-wrap gap-2.5">
          {entry.kpis.map((k) => {
            const value = nf(k.decimals).format(k.value) + (k.suffix ?? "");
            return (
              <div class="min-w-[120px] rounded-3 border border-line bg-term px-3.5 py-2.5">
                <dt class="text-2xl/[1.1] font-semibold tracking-[-0.03em] text-ink tabular-nums">
                  <span
                    aria-hidden="true"
                    data-count={k.value}
                    data-dec={k.decimals ?? 0}
                    data-suf={k.suffix ?? ""}
                  >
                    {value}
                  </span>
                  <span class="sr-only">{value}</span>
                </dt>
                <dd class="mt-0.5 text-[12.5px] text-ink-2">{pick(k.label, lang)}</dd>
              </div>
            );
          })}
        </dl>
      )
    }

    {
      entry.stories && (
        <details class="group/d mt-3.5 rounded-3 border border-line bg-[color-mix(in_srgb,var(--color-term)_60%,transparent)]">
          <summary class="flex cursor-pointer list-none items-center gap-[9px] rounded-3 px-3.5 py-2.5 font-mono text-[13.5px] leading-[normal] font-medium text-ink-2 [&::-webkit-details-marker]:hidden">
            <Icon name="lucide:git-pull-request" aria-hidden="true" class="size-4 shrink-0 text-accent" />
            {t("home.xp.stories")}
            <Icon
              name="lucide:chevron-down"
              aria-hidden="true"
              class="ml-auto size-4 shrink-0 text-accent transition-transform duration-300 group-open/d:rotate-180"
            />
          </summary>
          <ul class="grid list-none gap-2 px-3.5 pt-1 pb-3">
            {entry.stories.map((s) => (
              <li class="flex gap-2.5 text-[14.5px] text-ink-soft">
                <Icon name="lucide:circle-dot" aria-hidden="true" class="mt-[3px] size-4 shrink-0 text-ok" />
                <span>{pick(s, lang)}</span>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    {
      (entry.tech || entry.tags) && (
        <ul class="mt-3.5 flex list-none flex-wrap gap-2">
          {entry.tech?.map((id) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-line bg-surface-2 py-[3px] pr-2.5 pl-[3px] text-[12.5px] font-medium">
              <TechLogo id={id} class="size-5 rounded-full" />
              <span aria-hidden="true">{tech[id].label}</span>
            </li>
          ))}
          {entry.tags?.map((tag) => (
            <li class="inline-flex items-center rounded-full border border-line bg-surface-2 px-2.5 py-[3px] text-[12.5px] font-medium">
              {pick(tag, lang)}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {
    attachments.length > 0 && (
      <div class="grid gap-2.5">
        {attachments.map(({ src, full, alt }) => (
          <a
            href={full.src}
            data-att
            data-alt={alt}
            data-w={full.attributes.width}
            data-h={full.attributes.height}
            class="group relative block aspect-4/3 cursor-zoom-in overflow-hidden rounded-3 border border-line-strong bg-bg max-[979px]:aspect-video max-[979px]:max-w-[420px]"
          >
            <Image
              src={src}
              alt={alt}
              widths={[168, 336, 420, 640]}
              quality={60}
              sizes="(max-width: 979px) min(420px, calc(100vw - 100px)), 168px"
              loading="lazy"
              decoding="async"
              class="block size-full object-cover transition-transform duration-600 ease-brand motion-safe:group-hover:scale-[1.06]"
            />
            <span
              aria-hidden="true"
              class="absolute bottom-2 left-2 inline-flex items-center gap-1.5 rounded-full bg-[color-mix(in_srgb,var(--color-bg)_80%,transparent)] px-[9px] py-1 font-mono text-xs font-medium whitespace-nowrap"
            >
              <Icon name="lucide:image" class="size-[13px]" />
              {t("home.xp.view")}
            </span>
          </a>
        ))}
      </div>
    )
  }
</li>
