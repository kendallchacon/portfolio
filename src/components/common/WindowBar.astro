---
/** Barra de ventana con los tres puntos y un título en mono. */
interface Props {
  title: string;
  /** `sm` (por defecto): log de API y CI. `md`: terminal de Sobre mí (12×16, 13 px). */
  size?: "sm" | "md";
}

const { title, size = "sm" } = Astro.props;
---

<div
  class:list={[
    "flex items-center gap-3.5 border-b border-term-line bg-term-bar font-mono leading-[normal] text-term-ink",
    size === "md" ? "px-4 py-3 text-[13px]" : "px-3.5 py-2.5 text-xs",
  ]}
>
  <span class="inline-flex gap-1.5" aria-hidden="true">
    <i class="size-2.5 rounded-full bg-dot-close"></i>
    <i class="size-2.5 rounded-full bg-dot-min"></i>
    <i class="size-2.5 rounded-full bg-dot-max"></i>
  </span>
  <span>{title}</span>
</div>
