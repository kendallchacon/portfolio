---
import { Image } from "astro:assets";
import type { CaseShot } from "../../data/cases";
import { pick, type Localized } from "../../data/types";
import { useTranslations, type Lang } from "../../i18n/ui";
import { projectImage } from "../projects/media";

/**
 * "Capturas", cada una con su pie visible. Sin reproductor ni capítulos. La forma sale de la
 * primera captura: verticales (app móvil) en 2 columnas en móvil y 4 en escritorio; apaisadas
 * (navegador) en 1 columna y 2 en escritorio. Imágenes lazy con `astro:assets`; el `aspect-ratio`
 * reserva el hueco, así que no hay salto de layout. La nota inferior es la del caso o, por
 * defecto, "Datos de demostración".
 */
interface Props {
  shots: readonly CaseShot[];
  note?: Localized;
  lang: Lang;
}

const { shots, note, lang } = Astro.props;
const t = useTranslations(lang);
const wide = shots[0].width > shots[0].height;
---

<div class="mt-12">
  <h3 id="case-shots" class="mb-4 text-[21px]">{t("case.shots")}</h3>
  <ul
    role="list"
    aria-labelledby="case-shots"
    class:list={[
      "grid gap-y-6",
      wide
        ? "grid-cols-1 gap-x-4 min-[900px]:grid-cols-2 min-[900px]:gap-x-5"
        : "grid-cols-2 gap-x-4 min-[900px]:grid-cols-4 min-[900px]:gap-x-5",
    ]}
  >
    {
      shots.map((shot) => (
        <li class="min-w-0">
          <figure>
            <div
              class:list={[
                "overflow-hidden border border-line bg-paper",
                wide ? "rounded-2xl" : "aspect-[9/19.5] rounded-[22px]",
              ]}
              style={wide ? `aspect-ratio:${shot.width}/${shot.height}` : undefined}
            >
              <Image
                src={projectImage(shot.file)}
                alt={pick(shot.alt, lang)}
                widths={wide ? [480, 960, 1400] : [240, 480]}
                sizes={wide ? "(max-width: 899px) 100vw, 540px" : "(max-width: 899px) 45vw, 260px"}
                loading="lazy"
                decoding="async"
                class="block size-full object-cover"
              />
            </div>
            <figcaption class="mt-3 text-sm text-ink-2">{pick(shot.caption, lang)}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
  <p class="mt-5 font-mono text-[13px] text-ink-3">{note ? pick(note, lang) : t("case.shotsNote")}</p>
</div>
