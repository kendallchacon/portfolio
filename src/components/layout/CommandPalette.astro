---
import { Icon } from "astro-icon/components";
import { channelHref, contact } from "../../data/contact";
import { pick } from "../../data/types";
import {
  defaultLang,
  languageSwitchUrl,
  locales,
  paletteSections,
  sectionHref,
  useTranslations,
  type Lang,
} from "../../i18n/ui";
import { normalize } from "../../scripts/normalize";

// Paleta de comandos: <dialog> modal con patrón combobox + listbox. Se renderiza completa
// en el servidor; el script solo filtra, mueve la opción activa y ejecuta.

const lang: Lang = locales.find((l) => l === Astro.currentLocale) ?? defaultLang;
const t = useTranslations(lang);
const targetLang: Lang = lang === "es" ? "en" : "es";

type Item = {
  id: string;
  label: string;
  meta: string;
  href?: string;
  external?: boolean;
  download?: boolean;
  hreflang?: Lang;
  /** Texto que copia la opción (en lugar de navegar). */
  copy?: string;
  /** Enlace al que se recurre si el portapapeles no está disponible. */
  fallback?: string;
};

const channelItem = (id: "github" | "linkedin" | "cv"): Item[] => {
  const channel = contact.channels.find((c) => c.id === id);
  if (!channel) return [];
  return [
    {
      id,
      label: `${t("palette.action.open")} ${pick(channel.label, lang)}`,
      meta: pick(channel.value, lang),
      href: channelHref(channel, lang),
      external: "external" in channel,
      download: "download" in channel,
    },
  ];
};

const groups: { id: string; label: string; items: Item[] }[] = [
  {
    id: "goto",
    label: t("palette.group.goto"),
    items: paletteSections.map((id) => ({
      id,
      label: t(`nav.${id}`),
      meta: `~/${id}`,
      href: sectionHref(id, lang),
    })),
  },
  {
    id: "actions",
    label: t("palette.group.actions"),
    items: [
      {
        id: "email",
        label: t("palette.action.copyEmail"),
        meta: contact.email.address,
        copy: contact.email.address,
        fallback: contact.email.href,
      },
      ...channelItem("cv"),
      ...channelItem("github"),
      ...channelItem("linkedin"),
      {
        id: "lang",
        label: t("palette.action.lang"),
        meta: targetLang.toUpperCase(),
        href: languageSwitchUrl(Astro.url.pathname, targetLang),
        hreflang: targetLang,
      },
    ],
  },
];

const optionClass =
  "group flex min-h-11 cursor-pointer items-center justify-between gap-4 rounded-3 px-3 py-2 text-[15px] text-ink aria-selected:bg-accent-soft aria-selected:text-accent";
const metaClass = "min-w-0 truncate font-mono text-xs text-ink-2 group-aria-selected:text-accent";
---

<dialog
  data-palette
  aria-label={t("palette.label")}
  data-one={t("palette.results.one")}
  data-other={t("palette.results.other")}
  class="fixed inset-x-0 mx-auto mt-[12vh] mb-auto max-h-[calc(100dvh-12vh-1.5rem)] w-[min(560px,calc(100%-1.5rem))] max-w-none overflow-hidden rounded-2 border border-line-strong bg-surface-1 p-0 text-ink shadow-2xl backdrop:bg-bg/70"
>
  <div class="flex max-h-[inherit] flex-col">
    <div class="flex items-center gap-3 border-b border-line px-4 focus-within:border-accent">
      <Icon name="heroicons:magnifying-glass" class="size-5 shrink-0 text-ink-2" aria-hidden="true" />
      <input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label={t("palette.input")}
        placeholder={t("palette.placeholder")}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
        autofocus
        class="min-h-14 min-w-0 flex-1 bg-transparent text-base text-ink outline-none placeholder:text-ink-3"
      />
    </div>

    <div id="palette-list" role="listbox" aria-label={t("palette.label")} class="overflow-y-auto overscroll-contain p-2">
      {
        groups.map((group) => (
          <div role="group" aria-labelledby={`palette-group-${group.id}`}>
            <p
              id={`palette-group-${group.id}`}
              class="px-3 pt-2 pb-1 font-mono text-xs tracking-wider text-ink-2 uppercase"
            >
              {group.label}
            </p>
            {group.items.map((item) =>
              item.copy ? (
                <div
                  role="option"
                  id={`palette-option-${item.id}`}
                  aria-selected="false"
                  data-copy={item.copy}
                  data-fallback={item.fallback}
                  data-search={normalize(`${item.label} ${item.meta}`)}
                  class={optionClass}
                >
                  <span class="shrink-0">
                    <span data-label>{item.label}</span>
                    <span data-done hidden class="text-ok">
                      {t("palette.copied")}
                    </span>
                  </span>
                  {" "}
                  <span class={metaClass}>{item.meta}</span>
                </div>
              ) : (
                <a
                  role="option"
                  id={`palette-option-${item.id}`}
                  aria-selected="false"
                  tabindex="-1"
                  href={item.href}
                  hreflang={item.hreflang}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  download={item.download ? "" : undefined}
                  data-search={normalize(`${item.label} ${item.meta}`)}
                  class={optionClass}
                >
                  <span class="shrink-0">
                    {item.label}
                    {item.external && <span class="sr-only">{" "}{t("a11y.newTab")}</span>}
                  </span>
                  {" "}
                  <span class={metaClass}>{item.meta}</span>
                </a>
              ),
            )}
          </div>
        ))
      }
    </div>

    <p data-palette-empty hidden aria-hidden="true" class="px-4 py-10 text-center text-sm text-ink-2">
      {t("palette.empty")}
    </p>
    <p data-palette-status role="status" aria-live="polite" class="sr-only"></p>
  </div>
</dialog>

<style is:global>
  /* Scroll lock sin salto de layout: el gutter se reserva aunque el scroll se oculte. */
  html:has(dialog[data-palette][open]) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /* Destino de "Ir a": recibe el foco por código, sin anillo sobre toda la sección. */
  section[tabindex="-1"]:focus {
    outline: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    dialog[data-palette][open],
    dialog[data-palette][open]::backdrop {
      animation: palette-fade 150ms ease-out;
    }
  }

  @keyframes palette-fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  import { normalize } from "../../scripts/normalize";

  const dialog = document.querySelector<HTMLDialogElement>("dialog[data-palette]");
  const input = dialog?.querySelector("input");
  const empty = dialog?.querySelector<HTMLElement>("[data-palette-empty]");
  const status = dialog?.querySelector<HTMLElement>("[data-palette-status]");

  if (dialog && input && empty && status) {
    const options = Array.from(dialog.querySelectorAll<HTMLElement>("[role=option]"));
    const groups = Array.from(dialog.querySelectorAll<HTMLElement>("[role=group]"));
    const copyOption = dialog.querySelector<HTMLElement>("[data-copy]");
    let active: HTMLElement | undefined;
    let opener: HTMLElement | null = null;
    let destination: HTMLElement | null = null;
    let pressedOnBackdrop = false;
    let timer = 0;

    const visible = () => options.filter((o) => !o.hidden);
    const count = () => {
      const n = visible().length;
      return n ? `${n} ${n === 1 ? dialog.dataset.one : dialog.dataset.other}` : (empty.textContent ?? "");
    };

    const setActive = (option?: HTMLElement) => {
      active = option;
      options.forEach((o) => o.setAttribute("aria-selected", String(o === option)));
      if (option) {
        input.setAttribute("aria-activedescendant", option.id);
        option.scrollIntoView({ block: "nearest" });
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    };

    const filter = () => {
      const query = normalize(input.value);
      options.forEach((o) => (o.hidden = !o.dataset.search?.includes(query)));
      groups.forEach((g) => (g.hidden = !g.querySelector("[role=option]:not([hidden])")));
      const list = visible();
      empty.hidden = list.length > 0;
      input.setAttribute("aria-expanded", String(list.length > 0));
      setActive(list[0]);
      status.textContent = count();
    };

    const move = (step: number) => {
      const list = visible();
      if (!list.length) return;
      const next = (list.indexOf(active as HTMLElement) + step + list.length) % list.length;
      setActive(list[next]);
    };

    // Confirmación visible de "Copiado" durante 1,5 s; la paleta sigue abierta.
    const resetCopy = () => {
      window.clearTimeout(timer);
      copyOption?.querySelector<HTMLElement>("[data-label]")?.removeAttribute("hidden");
      copyOption?.querySelector<HTMLElement>("[data-done]")?.setAttribute("hidden", "");
      status.textContent = count();
    };

    const copy = async (option: HTMLElement) => {
      try {
        await navigator.clipboard.writeText(option.dataset.copy ?? "");
      } catch {
        // Sin portapapeles (contexto no seguro): abre el cliente de correo.
        if (option.dataset.fallback) location.href = option.dataset.fallback;
        return;
      }
      const done = option.querySelector<HTMLElement>("[data-done]");
      option.querySelector<HTMLElement>("[data-label]")?.setAttribute("hidden", "");
      done?.removeAttribute("hidden");
      status.textContent = done?.textContent ?? "";
      window.clearTimeout(timer);
      timer = window.setTimeout(resetCopy, 1500);
    };

    const open = () => {
      if (dialog.open) return;
      opener = document.activeElement as HTMLElement | null;
      input.value = "";
      filter();
      dialog.showModal();
    };

    // El foco vuelve a quien abrió la paleta, salvo al ir a una sección de la misma página,
    // donde pasa a la sección. Es idempotente: Esc lo dispara el evento "close"; el resto de
    // cierres lo llaman directo.
    const settle = () => {
      resetCopy();
      (destination ?? opener)?.focus({ preventScroll: true });
      destination = opener = null;
    };
    const dismiss = () => {
      dialog.close();
      settle();
    };
    dialog.addEventListener("close", settle);

    dialog.addEventListener("pointerdown", (e) => (pressedOnBackdrop = e.target === dialog));
    dialog.addEventListener("pointermove", (e) => {
      const option = (e.target as Element).closest<HTMLElement>("[role=option]");
      if (option && option !== active) setActive(option);
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) {
        if (pressedOnBackdrop) dismiss();
        return;
      }
      const option = (e.target as Element).closest<HTMLElement>("[role=option]");
      if (!option) return;
      if (option.dataset.copy) {
        void copy(option);
        return;
      }
      // Se cierra antes de mover el scroll para que el scroll lock ya esté liberado.
      dialog.close();
      if (option instanceof HTMLAnchorElement) {
        const url = new URL(option.href);
        const target = url.hash ? document.getElementById(url.hash.slice(1)) : null;
        const trim = (path: string) => path.replace(/\/$/, "");
        // Misma página y ancla existente: scroll aquí. Si no, el enlace navega (ruta + hash).
        if (target && url.origin === location.origin && trim(url.pathname) === trim(location.pathname)) {
          e.preventDefault();
          history.pushState(null, "", url.hash);
          if (!target.hasAttribute("tabindex")) target.tabIndex = -1;
          destination = target;
          target.scrollIntoView();
        }
      }
      settle();
    });

    input.addEventListener("input", filter);
    input.addEventListener("keydown", (e) => {
      if (e.isComposing) return;
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        move(e.key === "ArrowDown" ? 1 : -1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        active?.click();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (!(e.ctrlKey || e.metaKey) || e.altKey || e.shiftKey || e.key.toLowerCase() !== "k") return;
      e.preventDefault();
      if (dialog.open) dismiss();
      // Con el menú móvil abierto no se apila una segunda capa modal.
      else if (!document.querySelector("[data-menu-button][aria-expanded=true]")) open();
    });
    document.addEventListener("click", (e) => {
      if ((e.target as Element).closest("[data-open-palette]")) open();
    });

    // En Mac el atajo es ⌘ K.
    if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
      document.querySelectorAll("[data-kbd]").forEach((k) => (k.textContent = "⌘ K"));
    }
  }
</script>
