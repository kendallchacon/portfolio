---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import ProjectCard from "../components/sections/ProjectCard.astro";
import { projects } from "../data/projects";

const [featured, ...rest] = projects;
---

<BaseLayout
  title="Proyectos | Kendall Chacón"
  description="Proyectos reales con problema definido, aporte individual verificable y stack aplicado."
  image="/images/project-preview.jpg"
>
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-0 sm:px-6">
      <div class="reveal">
        <SectionHeader
          eyebrow="Proyectos"
          title="Lo que he construido"
          titleTag="h1"
          description="Proyectos reales con problema definido, aporte individual verificable y stack aplicado."
        />
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <!-- Beto y Más: ocupa las 2 columnas en desktop -->
        <div class="md:col-span-2">
          <ProjectCard project={featured} featured delay={0} />
        </div>

        <!-- Proyectos pendientes: side by side -->
        {rest.map((project, index) => (
          <ProjectCard
            project={project}
            delay={(index + 1) * 0.15}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
