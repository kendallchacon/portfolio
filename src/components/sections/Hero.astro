---
import ButtonLink from "../common/ButtonLink.astro";
import Terminal from "../common/Terminal.astro";
import { hero } from "../../data/hero";
---

<section id="home" class="py-16 sm:py-24">
  <div class="grid items-stretch gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
    <!-- Columna izquierda: jerarquía de mayor a menor peso visual -->
    <div class="hero-intro flex flex-col justify-center">
      <!-- Etiqueta de especialidad: categoría editorial discreta sobre el h1 -->
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-500 sm:text-sm"
      >
        {hero.eyebrow}
      </p>

      <!-- 1. Titular profesional: el elemento dominante -->
      <h1
        class="mt-4 max-w-2xl text-3xl font-bold leading-[1.12] tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        {hero.title}
      </h1>

      <!-- 2. Descripción: qué construye -->
      <p class="mt-6 max-w-xl text-base leading-7 text-slate-300 sm:text-lg">
        {hero.description}
      </p>

      <!-- 3. CTA orientados a conversión -->
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        {
          hero.ctas.map((cta) => (
            <ButtonLink href={cta.href} variant={cta.variant}>
              {cta.label}
            </ButtonLink>
          ))
        }
      </div>
    </div>

    <!-- Columna derecha: terminal como foco dominante -->
    <!-- Altura natural: muestra todo el contenido sin corte en cualquier pantalla.
         En desktop (lg) la columna estira la tarjeta y min-h-120 actúa de suelo. -->
    <div class="relative flex">
      <div
        class="pointer-events-none absolute -inset-4 rounded-4xl bg-cyan-400/5 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <Terminal
        fileName={hero.terminal.fileName}
        lines={hero.terminal.lines}
        statusBar={hero.terminal.statusBar}
      />
    </div>
  </div>
</section>
