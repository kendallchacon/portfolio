---
import { Icon } from "astro-icon/components";
import ButtonLink from "../common/ButtonLink.astro";
import TechLogo from "../common/TechLogo.astro";
import HeroGrid from "./HeroGrid.astro";
import { hero, profile } from "../../data/profile";
import { pick, type SectionId } from "../../data/types";
import { useTranslations, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** Icono de cada botón, según la sección a la que apunta. */
const buttonIcon: Partial<Record<SectionId, string>> = {
  proyectos: "heroicons:square-3-stack-3d",
  contacto: "heroicons:envelope",
};
---

<section
  id="inicio"
  class="relative isolate flex flex-col justify-center overflow-hidden pt-[calc(var(--header-h)+40px)] min-[761px]:min-h-svh min-[980px]:pt-[calc(var(--header-h)+44px)]"
>
  <HeroGrid />

  <div class="wrap relative flex flex-col items-center pb-16 text-center">
    <p
      class="inline-flex items-center gap-2.5 rounded-full border border-line-strong bg-surface-1 py-[7px] pr-[15px] pl-3 text-sm leading-[1.6] font-medium text-ink-2"
    >
      <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-ok"></span>
      <span>{pick(profile.availability.label, lang)}</span>
    </p>

    {/* Degradado solo en pantalla normal; con colores forzados vuelve al texto del sistema. */}
    <h1
      class="mt-[22px] max-w-[20ch] bg-linear-to-b from-white from-30% to-ink-2 bg-clip-text text-[clamp(34px,4.3vw,58px)] leading-[1.04] tracking-[-0.045em] text-transparent forced-colors:bg-none forced-colors:text-[CanvasText]"
    >
      {pick(hero.headline, lang)}
    </h1>

    <p class="mt-5 max-w-[58ch] text-[17px] leading-[1.55] text-pretty text-ink-2 min-[561px]:text-[18.5px]">
      {pick(hero.intro, lang)}
    </p>

    <div class="mt-[30px] flex flex-wrap justify-center gap-2.5">
      {
        hero.buttons.map((button) => {
          const icon = buttonIcon[button.href.slice(1) as SectionId];
          return (
            <ButtonLink href={button.href} variant={button.variant} tone="site">
              {icon && <Icon name={icon} class="size-[1.1em] shrink-0" aria-hidden="true" />}
              <span>{pick(button.label, lang)}</span>
            </ButtonLink>
          );
        })
      }
    </div>

    <ul class="lrow mt-[30px] justify-center" aria-label={t("home.logos.label")}>
      {hero.logos.map((id) => <li class="flex"><TechLogo id={id} /></li>)}
    </ul>
  </div>
</section>
